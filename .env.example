PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/todo
FRONTEND_URL=http://localhost:5173
TASK_APP_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_REFRESH_SECRET=use-a-different-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Migration email is required. Name/password are only required for a new owner account.
LEGACY_MIGRATION_OWNER_NAME=
LEGACY_MIGRATION_OWNER_EMAIL=
LEGACY_MIGRATION_OWNER_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_FROM_NUMBER=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=task_due_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en
# Twilio-only configuration, when WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TEMPLATE_SID=
